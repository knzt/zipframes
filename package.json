{
  "name": "zip-frames",
  "private": true,
  "version": "0.0.0",
  "description": "ZipFrames — sistema de processamento de vídeos da FIAP X",
  "scripts": {
    "build": "pnpm --dir services/processor-worker build",
    "test": "pnpm --dir services/processor-worker test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm --dir services/processor-worker typecheck",
    "check:layers": "sh validate-layers.sh",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "prepare": "husky",
    "infra:up": "docker compose -f infra/docker-compose/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose/docker-compose.yml logs -f",
    "infra:reset": "docker compose -f infra/docker-compose/docker-compose.yml down -v && docker compose -f infra/docker-compose/docker-compose.yml up -d"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "eslint": "^9.28.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "dependency-cruiser": "^16.10.2"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.9"
}
