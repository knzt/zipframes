{
  "name": "zip-frames",
  "private": true,
  "version": "0.0.0",
  "description": "ZipFrames — sistema de processamento de vídeos da FIAP X",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:layers": "sh validate-layers.sh",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "prepare": "husky",
    "infra:up": "docker compose -f infra/docker-compose/docker-compose.yml up -d",
    "infra:apps": "docker compose -f infra/docker-compose/docker-compose.yml --profile apps up -d --build",
    "infra:down": "docker compose -f infra/docker-compose/docker-compose.yml --profile apps down",
    "infra:logs": "docker compose -f infra/docker-compose/docker-compose.yml --profile apps logs -f",
    "infra:reset": "docker compose -f infra/docker-compose/docker-compose.yml --profile apps down -v && docker compose -f infra/docker-compose/docker-compose.yml up -d",
    "pnpm:auth": "pnpm --dir services/auth-service",
    "pnpm:worker": "pnpm --dir services/processor-worker",
    "deps:auth": "pnpm --dir services/auth-service add",
    "deps:worker": "pnpm --dir services/processor-worker add"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "eslint": "^9.28.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "dependency-cruiser": "^16.10.2"
  },
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.6.0"
}
