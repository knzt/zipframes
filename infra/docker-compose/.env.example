# Copie para .env antes de subir a infraestrutura:
#   cp infra/docker-compose/.env.example infra/docker-compose/.env
#
# Estes valores são apenas para o ambiente local.
# ─── auth-db ───────────────────────────────────────────────────────────
AUTH_DB_USER=zipframes
AUTH_DB_PASSWORD=zipframes
AUTH_DB_NAME=auth_db
AUTH_DB_PORT=5432

# ─── video-db ──────────────────────────────────────────────────────────
VIDEO_DB_USER=zipframes
VIDEO_DB_PASSWORD=zipframes
VIDEO_DB_NAME=video_db
VIDEO_DB_PORT=5433

# ─── notification-db ───────────────────────────────────────────────────
NOTIFICATION_DB_USER=zipframes
NOTIFICATION_DB_PASSWORD=zipframes
NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DB_PORT=5434

# ─── RabbitMQ ──────────────────────────────────────────────────────────
RABBITMQ_USER=zipframes
RABBITMQ_PASSWORD=zipframes
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ─── Redis ─────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ─── Object storage (SeaweedFS) ────────────────────────────────────────
# As credenciais também estão em seaweedfs/s3.json, que não interpola variáveis.
# Ao trocar uma, troque a outra.
STORAGE_ACCESS_KEY=zipframes
STORAGE_SECRET_KEY=zipframes-local-secret
STORAGE_REGION=us-east-1
STORAGE_BUCKET=videos
STORAGE_S3_PORT=8333
STORAGE_MASTER_PORT=9333
STORAGE_FILER_PORT=8888

# NODE_AUTH_TOKEN não entra na imagem do worker (o build usa stage-runtime).
# A imagem do auth-service instala dependências no build e lê esse token
# como secret do Compose. Exporte NODE_AUTH_TOKEN antes de `docker compose build`.

# ─── auth-service ──────────────────────────────────────────────────────
AUTH_HTTP_PORT=3000

# ─── processor-worker ──────────────────────────────────────────────────
PROCESSOR_HEALTH_PORT=8081

# ─── Mailpit ───────────────────────────────────────────────────────────
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
