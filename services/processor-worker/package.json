{
  "name": "@zipframes/processor-worker",
  "private": true,
  "version": "0.0.0",
  "description": "Extrai frames de vídeos e gera o pacote zip.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest --config vitest.unit.config.ts",
    "test:coverage": "vitest run --config vitest.unit.config.ts --coverage",
    "lint": "eslint .",
    "dev": "node --env-file=.env --import tsx --watch src/main/index.ts",
    "start": "node --env-file=.env dist/main/index.js",
    "stage-runtime": "node scripts/stage-runtime.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.787.0",
    "@zipframes/communication": "^0.3.0",
    "@zipframes/core": "^0.4.0",
    "@zipframes/logger": "^0.1.0",
    "@zipframes/schemas": "^1.3.0",
    "@zipframes/telemetry": "^0.1.0",
    "amqplib": "^0.10.8",
    "archiver": "^7.0.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.7",
    "@types/archiver": "^6.0.3",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@zipframes/test-toolkit": "^0.2.1",
    "ffmpeg-static": "^5.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.6.0"
}
