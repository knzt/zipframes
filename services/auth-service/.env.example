PORT=3000
CORS_ORIGIN=*
AUTH_DATABASE_URL=postgresql://zipframes:zipframes@localhost:5432/auth_db
AMQP_URL=amqp://zipframes:zipframes@localhost:5672
JWT_PRIVATE_KEY_PEM=
# Gerada por `pnpm dev:keygen` na raiz; não é versionada.
JWT_PRIVATE_KEY_FILE=../../infra/docker-compose/auth/jwt-dev.pem
JWT_KID=auth-dev-1
JWT_ISSUER=https://auth.zipframes.local
JWT_AUDIENCE=zipframes
LOG_LEVEL=info
SERVICE_VERSION=0.1.0
