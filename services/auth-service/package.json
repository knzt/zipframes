{
  "name": "@zipframes/auth-service",
  "version": "0.1.0",
  "private": true,
  "description": "Cadastro, autenticação e emissão de tokens do ZipFrames",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest --config vitest.unit.config.ts",
    "test:coverage": "vitest run --config vitest.unit.config.ts --coverage",
    "lint": "eslint .",
    "dev": "node --env-file=.env --import tsx --watch src/main/index.ts",
    "start": "node --env-file=.env dist/main/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@prisma/client": "^6.2.1",
    "@zipframes/communication": "^0.1.0",
    "@zipframes/core": "^0.4.0-pr39-20260925214648",
    "@zipframes/logger": "^0.1.0",
    "@zipframes/schemas": "^0.1.0",
    "@zipframes/telemetry": "^0.1.0",
    "@zipframes/value-objects": "^0.2.0",
    "amqplib": "^0.10.5",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.2.1",
    "jose": "^5.9.6",
    "prisma": "^6.2.1",
    "prom-client": "^15.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@zipframes/authenticator": "^0.1.0",
    "@zipframes/test-toolkit": "^0.2.1",
    "light-my-request": "^6.6.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.6.0",
  "prisma": {
    "schema": "src/infrastructure/repositories/prisma/schema.prisma"
  }
}
