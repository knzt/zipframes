{
  "name": "@zipframes/auth-service",
  "version": "0.1.0",
  "private": true,
  "description": "Cadastro, autenticação e emissão de tokens do ZipFrames",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "dev": "tsx watch src/main/index.ts",
    "start": "node dist/main/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@prisma/client": "^6.2.1",
    "@zipframes/communication": "^0.1.0",
    "@zipframes/core": "^0.1.0",
    "@zipframes/logger": "^0.1.0",
    "@zipframes/schemas": "^0.1.0",
    "@zipframes/telemetry": "^0.1.0",
    "@zipframes/value-objects": "^0.2.0",
    "amqplib": "^0.10.5",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.2.1",
    "jose": "^5.9.6",
    "prisma": "^6.2.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^3.2.4",
    "@zipframes/authenticator": "^0.1.0",
    "light-my-request": "^6.6.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.9"
}
